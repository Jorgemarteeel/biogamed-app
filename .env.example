# Copy to .env; generate independent random hex secrets (see README).
POSTGRES_PASSWORD=
SECRET_KEY=
FRONTEND_PORT=14004
BACKEND_PORT=19004

# Per socket IP, per process. Positive integers only.
AUTH_LOGIN_LIMIT=120
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_ACTIVATION_LIMIT=15
AUTH_ACTIVATION_WINDOW_SECONDS=600
AUTH_IMPORT_LIMIT=60
AUTH_IMPORT_WINDOW_SECONDS=600

# Activation email. Supply delivery credentials privately on the target environment.
BIOGAMED_PUBLIC_URL=http://localhost:14004
BIOGAMED_ACTIVATION_TTL_HOURS=24
BIOGAMED_INVITATION_COOLDOWN_SECONDS=60
BIOGAMED_SMTP_HOST=
BIOGAMED_SMTP_PORT=587
BIOGAMED_SMTP_SECURITY=starttls
BIOGAMED_SMTP_FROM=
BIOGAMED_SMTP_USERNAME=
BIOGAMED_SMTP_PASSWORD=
