# Copy to .env; generate independent random hex secrets (see README).
POSTGRES_PASSWORD=
SECRET_KEY=
FRONTEND_PORT=14004
BACKEND_PORT=19004

# Per socket IP, per process. Positive integers only.
AUTH_LOGIN_LIMIT=120
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_REGISTER_LIMIT=60
AUTH_REGISTER_WINDOW_SECONDS=3600
